// ── Default parameters ───────────────────────────────────
params.pod5                 = null
params.bam                  = null
params.control_pod5         = null
params.control_bam          = null
params.reference            = null
params.ground_truth         = null
params.control_ground_truth = null
params.outdir               = "results"
params.dorado_model         = "rna004_130bps_sup@v5.1.0"
params.dorado_path          = null   // Local Dorado bin directory; if set, the container is disabled
params.dorado_models_dir    = null   // Directory holding pre-downloaded Dorado models
params.dorado_container     = 'ghcr.io/iynes1/dorado:1.0'
params.kvalue               = 14
params.min_coverage         = 50
params.mod_threshold        = 15

// ── Default process resources ────────────────────────────
process {
    cpus   = 4
    memory = '16 GB'
    time   = '4h'
}

// ── Container definitions (shared by docker and singularity) ──
def containers = [
    align:   'ghcr.io/iynes1/minimap2-samtools:1.0',
    qc:      'ghcr.io/iynes1/nanoplot:1.0',
    modkit:  'ghcr.io/iynes1/modkit:1.0',
    python:  'ghcr.io/iynes1/python-scripts:1.0',
    dorado:  params.dorado_container
]

// ── Profiles ─────────────────────────────────────────────
profiles {

    // Singularity (default for HPC)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true

        process {
            stageInMode = 'copy'
            beforeScript = 'export PYTHONPATH="" && export MPLCONFIGDIR=/tmp'

            withName: 'ALIGN_WT|ALIGN_CONTROL|ALIGN' {
                container = containers.align
            }
            withName: 'READ_QC' {
                container = containers.qc
            }
            withName: 'PILEUP_WT|PILEUP_CONTROL|MODKIT_PILEUP|MODKIT_VALIDATE' {
                container = containers.modkit
            }
            withName: 'CALIBRATION_SWEEP|CALIBRATION_SWEEP_IVT|ACCURACY_COMPARISON|SUMMARISE' {
                container = containers.python
            }
            withName: 'BASECALL_WT|BASECALL_CONTROL' {
                container        = containers.dorado
                containerOptions = '--nv'   // Expose host GPUs to the container
            }
        }
    }

    // Docker (local development)
    docker {
        docker.enabled    = true
        docker.runOptions = "-v \$PWD:\$PWD"

        process {
            beforeScript = 'export PYTHONPATH="" && export MPLCONFIGDIR=/tmp'

            withName: 'ALIGN_WT|ALIGN_CONTROL|ALIGN' {
                container = containers.align
            }
            withName: 'READ_QC' {
                container = containers.qc
            }
            withName: 'PILEUP_WT|PILEUP_CONTROL|MODKIT_PILEUP|MODKIT_VALIDATE' {
                container = containers.modkit
            }
            withName: 'CALIBRATION_SWEEP|CALIBRATION_SWEEP_IVT|ACCURACY_COMPARISON|SUMMARISE' {
                container = containers.python
            }
            withName: 'BASECALL_WT|BASECALL_CONTROL' {
                container        = containers.dorado
                containerOptions = '--gpus all'   // Expose host GPUs to the container
            }
        }
    }

    // Spartan HPC (University of Melbourne)
    spartan {
        includeConfig 'conf/spartan.config'
    }
}
