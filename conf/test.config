// Minimal test run on the ONT DRACH context validation data (starts from BAM, no GPU needed)
// Data are downloaded automatically from ONT's public open data bucket
// Source: https://epi2me.nanoporetech.com/rna-mod-validation-data/
// Usage: nextflow run main.nf -profile test,docker

def ont = 'https://ont-open-data.s3.amazonaws.com/rna-modbase-validation_2025.03'

params {
    bam                  = "${ont}/basecalls/m6A_DRACH.bam"
    control_bam          = "${ont}/basecalls/control_DRACH.bam"
    reference            = "${ont}/references/drach_context_strands.fa"
    ground_truth         = "${ont}/references/drach_context_m6A_sites.bed"
    control_ground_truth = "${ont}/references/drach_context_A_sites.bed"
    mod_threshold        = 80
    outdir               = "results_test"
}

// Cap resources so the test fits on a laptop
process {
    resourceLimits = [ cpus: 4, memory: 8.GB, time: 2.h ]
}
