params {
    pod5         = "/data/projects/punim2974/data/pod5_pass/"
    reference    = "/data/projects/punim2974/data/references/GRCh38.primary_assembly.genome.fa"
    ground_truth = "/data/projects/punim2974/data/references/GSM6432590_293T-mRNA-1_35bp_m2.totalm6A.FDR.csv"
    outdir       = "results_benchmark_realworld_drach"
    models_dir   = "/data/projects/punim2974/software/dorado_models"
}

process {
    executor = 'slurm'
    account  = 'punim2974'
    cpus   = 4
    memory = '16 GB'
    time   = '4h'
    queue  = 'sapphire'
    beforeScript = 'export PATH=/home/yenanwang/.conda/envs/nanopore_env/bin:$PATH'

    withName: 'BASECALL' {
        queue       = 'gpu-a100'
        clusterOptions = '--gres=gpu:1'
        cpus        = 4
        memory      = '64 GB'
        time        = '12h'
        beforeScript = 'export PATH=/apps/easybuild-2022/easybuild/software/MPI/GCC/11.3.0/OpenMPI/4.1.4/dorado/1.3.1-CUDA-12.2.0/bin:/home/yenanwang/.conda/envs/nanopore_env/bin:$PATH'
    }

    withName: 'ALIGN' {
        cpus   = 8
        memory = '32 GB'
        time   = '6h'
    }

    withName: 'MODKIT_PILEUP' {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }

    withName: 'CALIBRATION_SWEEP' {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
    }

    withName: 'SUMMARISE' {
        cpus   = 1
        memory = '2 GB'
        time   = '10m'
    }
}

trace {
    enabled = true
    file    = "${params.outdir}/trace.txt"
    fields  = 'task_id,name,tag,status,exit,realtime,cpus,%cpu,memory,peak_rss,rchar,wchar'
}

timeline {
    enabled = true
    file    = "${params.outdir}/timeline.html"
}
