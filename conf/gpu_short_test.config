// Spartan HPC only: use with -profile singularity,spartan -c conf/gpu_short_test.config
// Short GPU request for small validation datasets
// Multiple A100 partitions: SLURM starts the job on whichever frees up first
process {
    withName: 'BASECALL_WT|BASECALL_CONTROL' {
        queue = 'gpu-a100-short,gpu-a100'
        time  = '2h'
    }
}
