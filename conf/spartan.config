// ── Spartan HPC (University of Melbourne) ────────────────
// Usage: nextflow run main.nf -profile singularity,spartan

process {
    executor = 'slurm'
    queue    = 'sapphire'
    account  = 'punim2974'

    // GPU processes: basecalling with Dorado via module load
    withName: 'BASECALL_WT|BASECALL_CONTROL' {
        queue          = 'gpu-a100'
        cpus           = 8
        memory         = '32 GB'
        time           = '24h'
        clusterOptions = '--gpus=1'
        container      = null
        beforeScript   = """\
            export PYTHONPATH=""
            export PATH=/apps/easybuild-2022/easybuild/software/MPI/GCC/11.3.0/OpenMPI/4.1.4/dorado/1.3.1-CUDA-12.2.0/bin:\$PATH
            export LD_LIBRARY_PATH=/apps/easybuild-2022/easybuild/software/MPI/GCC/11.3.0/OpenMPI/4.1.4/dorado/1.3.1-CUDA-12.2.0/lib:/apps/easybuild-2022/easybuild/software/Core/CUDA/12.2.0/lib:/apps/easybuild-2022/easybuild/software/Core/CUDA/12.2.0/nvvm/lib64:/apps/easybuild-2022/easybuild/software/Core/cuDNN/8.9.3.28-CUDA-12.2.0/lib:/apps/easybuild-2022/easybuild/software/Core/CUDA/12.2.0/extras/CUPTI/lib64:\$LD_LIBRARY_PATH
        """.stripIndent()
    }

    withName: 'ALIGN_WT|ALIGN_CONTROL|ALIGN' {
        cpus   = 8
        memory = '32 GB'
        time   = '8h'
    }

    withName: 'PILEUP_WT|PILEUP_CONTROL|MODKIT_PILEUP' {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }

    withName: 'MODKIT_VALIDATE' {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }

    withName: 'READ_QC' {
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
    }

    withName: 'CALIBRATION_SWEEP|CALIBRATION_SWEEP_IVT|ACCURACY_COMPARISON|SUMMARISE' {
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }
}
