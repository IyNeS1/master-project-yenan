// ── Conda ────────────────────────────────────────────────
// Conda activation handled via PATH in beforeScript
// because Spartan module system conflicts with Nextflow conda integration
conda.enabled = false

// ── Default process settings ─────────────────────────────
process {
    executor     = 'slurm'
    queue        = 'sapphire'
    account      = 'punim2974'
    cpus         = 4
    memory       = '16 GB'
    time         = '4h'
    beforeScript = 'export PATH=/home/yenanwang/.conda/envs/nanopore_env/bin:$PATH && export PYTHONPATH=""'

    // GPU processes: basecalling with Dorado
    withName: 'BASECALL|BASECALL_CONTROL' {
        queue          = 'gpu-a100'
        cpus           = 8
        memory         = '32 GB'
        time           = '24h'
        clusterOptions = '--gpus=1'
        beforeScript   = """\
            export PYTHONPATH=""
            export PATH=/apps/easybuild-2022/easybuild/software/MPI/GCC/11.3.0/OpenMPI/4.1.4/dorado/1.3.1-CUDA-12.2.0/bin:\$PATH
            export LD_LIBRARY_PATH=/apps/easybuild-2022/easybuild/software/MPI/GCC/11.3.0/OpenMPI/4.1.4/dorado/1.3.1-CUDA-12.2.0/lib:/apps/easybuild-2022/easybuild/software/Core/CUDA/12.2.0/lib:/apps/easybuild-2022/easybuild/software/Core/CUDA/12.2.0/nvvm/lib64:/apps/easybuild-2022/easybuild/software/Core/cuDNN/8.9.3.28-CUDA-12.2.0/lib:/apps/easybuild-2022/easybuild/software/Core/CUDA/12.2.0/extras/CUPTI/lib64:\$LD_LIBRARY_PATH
        """.stripIndent()
    }

    // Alignment
    withName: 'ALIGN|ALIGN_CONTROL' {
        cpus   = 8
        memory = '32 GB'
        time   = '8h'
    }

    // Modkit pileup
    withName: 'MODKIT_PILEUP' {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }

    // Calibration sweep
    withName: 'CALIBRATION_SWEEP' {
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    // Read QC
    withName: 'READ_QC' {
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
    }

    // Modkit validate
    withName: 'MODKIT_VALIDATE' {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }
}