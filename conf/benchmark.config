params {
    pod5        = "/data/projects/punim2974/data/benchmark_subset/m6A_DRACH.pod5"
    reference   = "/data/projects/punim2974/data/benchmark_subset/drach_context_strands.fa"
    ground_truth = "/data/projects/punim2974/data/benchmark_subset/drach_context_m6A_sites.bed"
    outdir      = "results_benchmark"
    models_dir  = "/data/projects/punim2974/software/dorado_models"
}

process {
    executor = 'slurm'
    account  = 'punim2974'
    cpus   = 4
    memory = '16 GB'
    time   = '2h'
    queue  = 'sapphire'
    beforeScript = 'export PATH=/home/yenanwang/.conda/envs/nanopore_env/bin:$PATH'

    withName: 'BASECALL' {
        queue       = 'gpu-a100'
        clusterOptions = '--gres=gpu:1'
        cpus        = 4
        memory      = '32 GB'
        time        = '4h'
        beforeScript = 'export PATH=/apps/easybuild-2022/easybuild/software/MPI/GCC/11.3.0/OpenMPI/4.1.4/dorado/1.3.1-CUDA-12.2.0/bin:/home/yenanwang/.conda/envs/nanopore_env/bin:$PATH'
    }

    withName: 'ALIGN' {
        cpus   = 8
        memory = '16 GB'
        time   = '2h'
    }

    withName: 'MODKIT_PILEUP' {
        cpus   = 4
        memory = '8 GB'
        time   = '1h'
    }

    withName: 'CALIBRATION_SWEEP' {
        cpus   = 2
        memory = '4 GB'
        time   = '30m'
    }

    withName: 'SUMMARISE' {
        cpus   = 1
        memory = '2 GB'
        time   = '10m'
    }
}

trace {
    enabled = true
    file    = "${params.outdir}/trace.txt"
    fields  = 'task_id,name,tag,status,exit,realtime,cpus,%cpu,memory,peak_rss,rchar,wchar'
}

timeline {
    enabled = true
    file    = "${params.outdir}/timeline.html"
}
