// ── Spartan HPC (University of Melbourne) ────────────────
// Usage: nextflow run main.nf -profile singularity,spartan

process {
    executor = 'slurm'
    queue    = 'sapphire'
    account  = 'punim2974'

    // GPU processes: Dorado basecalling
    // Default: container from params.dorado_container (set in nextflow.config profiles)
    // Local mode: pass --dorado_path <bin dir> to use a locally installed Dorado instead
    withName: 'BASECALL_WT|BASECALL_CONTROL' {
        queue          = 'gpu-a100'
        cpus           = 8
        memory         = '32 GB'
        time           = '24h'
        clusterOptions = '--gpus=1'
        container      = params.dorado_path ? null : params.dorado_container
        beforeScript   = params.dorado_path ? """\
                export PYTHONPATH=""
                export PATH=${params.dorado_path}:\$PATH
                export LD_LIBRARY_PATH=${params.dorado_path}/../lib:/apps/easybuild-2022/easybuild/software/Core/CUDA/12.2.0/lib:/apps/easybuild-2022/easybuild/software/Core/CUDA/12.2.0/nvvm/lib64:/apps/easybuild-2022/easybuild/software/Core/cuDNN/8.9.3.28-CUDA-12.2.0/lib:/apps/easybuild-2022/easybuild/software/Core/CUDA/12.2.0/extras/CUPTI/lib64:\$LD_LIBRARY_PATH
            """.stripIndent() : 'export PYTHONPATH="" && export MPLCONFIGDIR=/tmp'
    }

    withName: 'ALIGN_WT|ALIGN_CONTROL|ALIGN' {
        cpus   = 8
        memory = '32 GB'
        time   = '8h'
    }

    withName: 'MODKIT_PILEUP_WT|MODKIT_PILEUP_CONTROL|MODKIT_PILEUP' {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }

    withName: 'MODKIT_VALIDATE' {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }

    withName: 'READ_QC|READ_QC_WT|READ_QC_CONTROL' {
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
    }

    withName: 'CALIBRATION_SWEEP|CALIBRATION_SWEEP_IVT|ACCURACY_COMPARISON|SUMMARISE' {
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }
}
